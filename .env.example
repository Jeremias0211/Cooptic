# Copiá este archivo como .env para conectar con Supabase.
# Si NO existe el .env, la app funciona en MODO DEMO (datos de prueba en el navegador).
#
# Solo van datos PÚBLICOS: la URL del proyecto y la clave "anon/publishable".
# NUNCA pongas acá la clave service_role ni contraseñas.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica
# Dominio usado para iniciar sesión con DNI (DNI@dominio)
VITE_DOMINIO_DNI=cooptic.escuela
